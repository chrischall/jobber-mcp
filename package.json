{
  "name": "@chrischall/jobber-mcp",
  "version": "1.0.2",
  "license": "MIT",
  "mcpName": "io.github.chrischall/jobber-mcp",
  "description": "Jobber Client Hub MCP server for Claude — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/jobber-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "jobber",
    "client-hub",
    "invoices",
    "appointments",
    "home-services"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "jobber-mcp": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "dev": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^2.4.0",
    "@fetchproxy/server": "^3.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
